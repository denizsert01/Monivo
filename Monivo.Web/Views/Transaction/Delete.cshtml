@model Monivo.Web.ViewModels.Transactions.DeleteTransactionViewModel

@{
    ViewData["Title"] = "Delete Transaction";
}

<div class="transaction-page">
    <div class="transaction-glow transaction-glow-one"></div>
    <div class="transaction-glow transaction-glow-two"></div>

    <div class="transaction-card">

        <div class="transaction-badge danger-badge">
            ✦ Delete Transaction
        </div>

        <h2 class="transaction-title">
            Delete this <span>transaction?</span>
        </h2>

        <p class="transaction-subtitle">
            This action cannot be undone. Please review the transaction before deleting it.
        </p>

        <div class="delete-warning">
            <div class="delete-warning-icon">
                !
            </div>

            <div>
                <strong>Are you sure?</strong>
                <span>
                    This transaction will be permanently removed.
                </span>
            </div>
        </div>

        <div class="transaction-details">

            <div class="detail-row">
                <span class="detail-label">
                    Category
                </span>

                <span class="detail-value">
                    @Model.CategoryName
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label">
                    Amount
                </span>

                <span class="detail-value amount-value">
                    ₺@Model.Amount.ToString("N2")
                </span>
            </div>

            <div class="detail-row">
                <span class="detail-label">
                    Date
                </span>

                <span class="detail-value">
                    @Model.TransactionDate.ToString("dd.MM.yyyy")
                </span>
            </div>

            <div class="detail-row description-row">
                <span class="detail-label">
                    Description
                </span>

                <span class="detail-value">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                                        ? "-"
                                        : Model.Description)
                </span>
            </div>

        </div>

        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div class="transaction-actions">

                <button type="submit"
                        class="transaction-danger-button">
                    Delete Transaction
                </button>

                <a asp-action="Index"
                   class="transaction-secondary-button">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

<style>

    .transaction-page {
        position: relative;
        min-height: 74vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        padding: 55px 20px;
        border-radius: 28px;
        background: radial-gradient( circle at 12% 18%, rgba(34, 197, 94, 0.17), transparent 34% ), radial-gradient( circle at 88% 82%, rgba(16, 185, 129, 0.14), transparent 35% ), linear-gradient( 135deg, #f8fff9 0%, #eefaf2 48%, #e8f8ef 100% );
    }

    .transaction-card {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 560px;
        padding: 42px;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 22px;
        backdrop-filter: blur(14px);
        box-shadow: 0 20px 55px rgba(30, 90, 55, 0.10);
    }

    .transaction-badge {
        display: inline-block;
        padding: 7px 14px;
        margin-bottom: 20px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .danger-badge {
        background: #fff1f2;
        color: #be123c;
    }

    .transaction-title {
        margin-bottom: 10px;
        color: #18251d;
        font-size: 2rem;
        font-weight: 750;
        letter-spacing: -1px;
    }

        .transaction-title span {
            color: #dc2626;
        }

    .transaction-subtitle {
        margin-bottom: 25px;
        color: #718078;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .delete-warning {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 22px;
        padding: 16px;
        background: rgba(255, 247, 237, 0.85);
        border: 1px solid #fed7aa;
        border-radius: 14px;
    }

    .delete-warning-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #fee2e2;
        color: #dc2626;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .delete-warning strong {
        display: block;
        color: #7c2d12;
        font-size: 0.88rem;
    }

    .delete-warning span {
        display: block;
        margin-top: 2px;
        color: #8a5a44;
        font-size: 0.82rem;
    }

    .transaction-details {
        overflow: hidden;
        margin-bottom: 28px;
        background: rgba(248, 253, 249, 0.8);
        border: 1px solid #e1ebe4;
        border-radius: 14px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 14px 17px;
        border-bottom: 1px solid #e7eee9;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

    .detail-label {
        color: #758179;
        font-size: 0.84rem;
        font-weight: 600;
    }

    .detail-value {
        color: #26352c;
        font-size: 0.92rem;
        font-weight: 600;
        text-align: right;
    }

    .amount-value {
        color: #166534;
        font-size: 1rem;
    }

    .description-row {
        align-items: flex-start;
    }

        .description-row .detail-value {
            max-width: 65%;
            font-weight: 500;
            overflow-wrap: anywhere;
        }

    .transaction-actions {
        display: flex;
        gap: 12px;
    }

    .transaction-danger-button,
    .transaction-secondary-button {
        flex: 1;
        padding: 12px 18px;
        border-radius: 11px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .transaction-danger-button {
        border: none;
        background: #dc2626;
        color: white;
        box-shadow: 0 10px 24px rgba(220, 38, 38, 0.16);
    }

        .transaction-danger-button:hover {
            background: #b91c1c;
            transform: translateY(-1px);
            box-shadow: 0 13px 28px rgba(220, 38, 38, 0.22);
        }

    .transaction-secondary-button {
        border: 1px solid #cfe0d3;
        background: white;
        color: #166534;
    }

        .transaction-secondary-button:hover {
            background: #f2fbf5;
            border-color: #b9d8c0;
            color: #14532d;
            transform: translateY(-1px);
        }

    .transaction-glow {
        position: absolute;
        border-radius: 50%;
        opacity: 0.48;
        filter: blur(5px);
    }

    .transaction-glow-one {
        width: 260px;
        height: 260px;
        top: -110px;
        right: 8%;
        background: rgba(74, 222, 128, 0.17);
    }

    .transaction-glow-two {
        width: 290px;
        height: 290px;
        bottom: -145px;
        left: 7%;
        background: rgba(16, 185, 129, 0.14);
    }

    @@media (max-width: 576px) {

        .transaction-page {
            padding: 35px 15px;
        }

        .transaction-card {
            padding: 30px 22px;
        }

        .transaction-actions {
            flex-direction: column;
        }

        .transaction-title {
            font-size: 1.7rem;
        }

        .detail-row {
            align-items: flex-start;
        }
    }

</style>