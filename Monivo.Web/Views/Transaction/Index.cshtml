@model List<Monivo.Application.DTOs.Transactions.TransactionDto>

@{
    ViewData["Title"] = "Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Transactions</h2>
        <p class="text-muted mb-0">
            Manage your income and expenses.
        </p>
    </div>

    <a asp-controller="Transaction"
       asp-action="Create"
       class="btn btn-primary">
        New Transaction
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-light border">
        No transactions found yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Amount</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var transaction in Model)
                {
                    <tr>
                        <td>
                            @transaction.TransactionDate.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @transaction.CategoryName
                        </td>

                        <td>
                            @transaction.TransactionType
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(transaction.Description)
                                                ? "-"
                                                : transaction.Description)
                </td>

                        <td>
                            @transaction.Amount.ToString("N2")
                        </td>

                        <td class="text-end">
                            <a asp-action="Edit"
                               asp-route-id="@transaction.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@transaction.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                        }
            </tbody>
        </table>
    </div>
}