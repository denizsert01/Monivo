<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Monivo</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        body {
            background: #fbfdfb;
            color: #1f2d24;
        }

        .monivo-navbar {
            background: rgba(255, 255, 255, 0.92);
            border-bottom: 1px solid #e8efe9;
            backdrop-filter: blur(12px);
            padding: 14px 0;
        }

        .monivo-brand {
            font-size: 1.35rem;
            font-weight: 750;
            color: #14251a !important;
            letter-spacing: -0.5px;
        }

        .monivo-nav-link {
            color: #6a766e !important;
            font-weight: 500;
            padding-left: 12px !important;
            padding-right: 12px !important;
            transition: color 0.2s ease;
        }

            .monivo-nav-link:hover {
                color: #15803d !important;
            }

        .monivo-user {
            color: #607066;
            font-size: 0.9rem;
        }

        .monivo-auth-link {
            color: #4f5e55 !important;
            font-weight: 500;
        }

            .monivo-auth-link:hover {
                color: #15803d !important;
            }

        .btn-monivo-register {
            background: #15803d;
            color: white !important;
            border-radius: 10px;
            padding: 7px 16px !important;
            margin-left: 6px;
            transition: background 0.2s ease, transform 0.2s ease;
        }

            .btn-monivo-register:hover {
                background: #166534;
                transform: translateY(-1px);
            }

        .btn-monivo-logout {
            border: 1px solid #d7e4da;
            background: #ffffff;
            color: #166534;
            border-radius: 9px;
            padding: 6px 14px;
            font-size: 0.85rem;
            font-weight: 500;
            transition: background 0.2s ease, border-color 0.2s ease;
        }

            .btn-monivo-logout:hover {
                background: #f0faf3;
                border-color: #b9d9c1;
            }

        .main-container {
            padding-top: 18px;
            padding-bottom: 35px;
        }

        @@media (max-width: 768px) {
            .monivo-user {
                margin-top: 10px;
                margin-bottom: 10px;
            }

            .btn-monivo-register {
                margin-left: 0;
                margin-top: 5px;
            }
        }
    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg monivo-navbar">
            <div class="container">

                <a class="navbar-brand monivo-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    Monivo
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="navbarSupportedContent">

                    <ul class="navbar-nav me-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link monivo-nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link monivo-nav-link"
                                   asp-controller="Category"
                                   asp-action="Index">
                                    Categories
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link monivo-nav-link"
                                   asp-controller="Transaction"
                                   asp-action="Index">
                                    Transactions
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav align-items-lg-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center gap-3">

                                <span class="monivo-user">
                                    @User.FindFirst(
                                    System.Security.Claims.ClaimTypes.Email
                                                                )?.Value
                            </span>

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="mb-0">

                                    <button type="submit"
                                            class="btn-monivo-logout">
                                        Logout
                                    </button>

                                </form>

                            </li>
                                                }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link monivo-auth-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link btn-monivo-register"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync(
    "Scripts",
        required: false
        )

</body>
</html>