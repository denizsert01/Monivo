@model List<Monivo.Application.DTOs.Categories.CategoryDto>

@{
    ViewData["Title"] = "Categories";
}

<div class="category-index-page">

    <div class="category-glow category-glow-one"></div>
    <div class="category-glow category-glow-two"></div>

    <div class="category-index-content">

        <div class="category-header">

            <div>
                <div class="category-badge">
                    ✦ Categories
                </div>

                <h2 class="category-title">
                    Manage your <span>categories</span>
                </h2>

                <p class="category-subtitle">
                    Organize your income and expenses with categories that make sense to you.
                </p>
            </div>

            <a asp-action="Create"
               class="create-category-button">
                <span class="plus-icon">+</span>
                New Category
            </a>

        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    ◎
                </div>

                <h4>No categories yet</h4>

                <p>
                    Create your first category to start organizing your transactions.
                </p>

                <a asp-action="Create"
                   class="empty-create-button">
                    Create your first category
                </a>

            </div>
        }
        else
        {
            <div class="category-table-card">

                <div class="table-responsive">

                    <table class="table category-table">

                        <thead>
                            <tr>
                                <th>Category Name</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var category in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="category-name-cell">

                                            <div class="category-icon">
                                                ◎
                                            </div>

                                            <span>
                                                @category.CategoryName
                                            </span>

                                        </div>
                                    </td>

                                    <td class="text-end">

                                        <div class="category-actions">

                                            <a asp-action="Edit"
                                               asp-route-id="@category.Id"
                                               class="edit-button">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@category.Id"
                                               class="delete-button">
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

        <div class="category-footer-info">
            <span>
                @Model.Count @(Model.Count == 1 ? "category" : "categories")
            </span>
        </div>

    </div>
</div>

<style>

    .category-index-page {
        position: relative;
        min-height: 72vh;
        overflow: hidden;
        padding: 55px;
        border-radius: 28px;
        background: radial-gradient( circle at 12% 15%, rgba(34, 197, 94, 0.17), transparent 34% ), radial-gradient( circle at 90% 85%, rgba(16, 185, 129, 0.14), transparent 35% ), linear-gradient( 135deg, #f8fff9 0%, #eefaf2 48%, #e8f8ef 100% );
    }

    .category-index-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 1050px;
        margin: 0 auto;
    }

    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 30px;
        margin-bottom: 30px;
    }

    .category-badge {
        display: inline-block;
        padding: 7px 14px;
        margin-bottom: 16px;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(22, 101, 52, 0.10);
        border-radius: 999px;
        color: #15803d;
        font-size: 0.8rem;
        font-weight: 600;
        backdrop-filter: blur(10px);
    }

    .category-title {
        margin-bottom: 8px;
        color: #18251d;
        font-size: 2.3rem;
        font-weight: 750;
        letter-spacing: -1.5px;
    }

        .category-title span {
            color: #16a34a;
        }

    .category-subtitle {
        max-width: 600px;
        margin: 0;
        color: #718078;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .create-category-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 12px 19px;
        border-radius: 11px;
        background: #15803d;
        color: white;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 10px 24px rgba(21, 128, 61, 0.18);
        transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

        .create-category-button:hover {
            background: #166534;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(21, 128, 61, 0.23);
        }

    .plus-icon {
        font-size: 1.15rem;
        line-height: 1;
    }

    .category-table-card {
        overflow: hidden;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.90);
        border-radius: 18px;
        backdrop-filter: blur(14px);
        box-shadow: 0 18px 45px rgba(30, 90, 55, 0.08);
    }

    .category-table {
        margin-bottom: 0;
    }

        .category-table thead {
            background: rgba(241, 250, 244, 0.8);
        }

        .category-table th {
            padding: 16px 22px;
            border-bottom: 1px solid #e4ece6;
            color: #68766d;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }

        .category-table td {
            padding: 17px 22px;
            vertical-align: middle;
            border-bottom: 1px solid #edf2ee;
            color: #334139;
        }

        .category-table tbody tr:last-child td {
            border-bottom: none;
        }

        .category-table tbody tr {
            transition: background 0.2s ease;
        }

            .category-table tbody tr:hover {
                background: rgba(240, 253, 244, 0.65);
            }

    .category-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        font-weight: 600;
    }

    .category-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 37px;
        height: 37px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #dcfce7;
        color: #15803d;
        font-weight: 700;
    }

    .category-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .edit-button,
    .delete-button {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }

    .edit-button {
        background: #f0faf3;
        border: 1px solid #cfe7d5;
        color: #166534;
    }

        .edit-button:hover {
            background: #dcfce7;
            border-color: #b8ddc2;
            color: #14532d;
            transform: translateY(-1px);
        }

    .delete-button {
        background: #fff7f7;
        border: 1px solid #f3d0d0;
        color: #b91c1c;
    }

        .delete-button:hover {
            background: #fee2e2;
            border-color: #fecaca;
            color: #991b1b;
            transform: translateY(-1px);
        }

    .category-footer-info {
        margin-top: 15px;
        color: #829087;
        font-size: 0.82rem;
        text-align: right;
    }

    .empty-state {
        padding: 65px 25px;
        background: rgba(255, 255, 255, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.90);
        border-radius: 18px;
        backdrop-filter: blur(14px);
        box-shadow: 0 18px 45px rgba(30, 90, 55, 0.07);
        text-align: center;
    }

    .empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 55px;
        height: 55px;
        margin: 0 auto 18px;
        border-radius: 15px;
        background: #dcfce7;
        color: #15803d;
        font-size: 1.4rem;
    }

    .empty-state h4 {
        color: #26362c;
        font-weight: 700;
    }

    .empty-state p {
        margin: 8px auto 22px;
        max-width: 430px;
        color: #77847c;
    }

    .empty-create-button {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 10px;
        background: #15803d;
        color: white;
        font-weight: 600;
        text-decoration: none;
    }

        .empty-create-button:hover {
            background: #166534;
            color: white;
        }

    .category-glow {
        position: absolute;
        border-radius: 50%;
        opacity: 0.48;
        filter: blur(5px);
    }

    .category-glow-one {
        width: 280px;
        height: 280px;
        top: -130px;
        right: 5%;
        background: rgba(74, 222, 128, 0.17);
    }

    .category-glow-two {
        width: 320px;
        height: 320px;
        bottom: -160px;
        left: 4%;
        background: rgba(16, 185, 129, 0.14);
    }

    @@media (max-width: 768px) {

        .category-index-page {
            padding: 35px 20px;
        }

        .category-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .create-category-button {
            width: 100%;
        }

        .category-title {
            font-size: 1.9rem;
        }
    }

</style>