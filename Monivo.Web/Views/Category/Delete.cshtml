@model Monivo.Application.Features.Categories.Commands.DeleteCategory.DeleteCategoryCommand

@{
    ViewData["Title"] = "Delete Category";
}

<div class="category-page">
    <div class="category-glow category-glow-one"></div>
    <div class="category-glow category-glow-two"></div>

    <div class="category-card">

        <div class="category-badge danger-badge">
            ✦ Delete Category
        </div>

        <h2 class="category-title">
            Delete this <span>category?</span>
        </h2>

        <p class="category-subtitle">
            This action cannot be undone. Please confirm that you want to remove this category.
        </p>

        <div class="delete-warning">
            <div class="delete-warning-icon">
                !
            </div>

            <div>
                <strong>Category Name</strong>
                <span>@Model.CategoryName</span>
            </div>
        </div>

        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div class="category-actions">

                <button type="submit"
                        class="category-danger-button">
                    Delete Category
                </button>

                <a asp-action="Index"
                   class="category-secondary-button">
                    Cancel
                </a>

            </div>

        </form>

    </div>
</div>

<style>

    .category-page {
        position: relative;
        min-height: 72vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        padding: 55px 20px;
        border-radius: 28px;
        background: radial-gradient( circle at 12% 20%, rgba(34, 197, 94, 0.17), transparent 34% ), radial-gradient( circle at 88% 80%, rgba(16, 185, 129, 0.14), transparent 35% ), linear-gradient( 135deg, #f8fff9 0%, #eefaf2 48%, #e8f8ef 100% );
    }

    .category-card {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 520px;
        padding: 42px;
        background: rgba(255, 255, 255, 0.78);
        border: 1px solid rgba(255, 255, 255, 0.9);
        border-radius: 22px;
        backdrop-filter: blur(14px);
        box-shadow: 0 20px 55px rgba(30, 90, 55, 0.10);
    }

    .category-badge {
        display: inline-block;
        padding: 7px 14px;
        margin-bottom: 20px;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .danger-badge {
        background: #fff1f2;
        color: #be123c;
    }

    .category-title {
        margin-bottom: 10px;
        color: #18251d;
        font-size: 2rem;
        font-weight: 750;
        letter-spacing: -1px;
    }

        .category-title span {
            color: #dc2626;
        }

    .category-subtitle {
        margin-bottom: 28px;
        color: #718078;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .delete-warning {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 28px;
        padding: 18px;
        background: rgba(255, 247, 237, 0.85);
        border: 1px solid #fed7aa;
        border-radius: 14px;
    }

    .delete-warning-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #fee2e2;
        color: #dc2626;
        font-size: 1.1rem;
        font-weight: 800;
    }

    .delete-warning strong {
        display: block;
        color: #7c2d12;
        font-size: 0.86rem;
    }

    .delete-warning span {
        display: block;
        margin-top: 3px;
        color: #3f3f46;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .category-actions {
        display: flex;
        gap: 12px;
    }

    .category-danger-button,
    .category-secondary-button {
        flex: 1;
        padding: 12px 18px;
        border-radius: 11px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .category-danger-button {
        border: none;
        background: #dc2626;
        color: white;
        box-shadow: 0 10px 24px rgba(220, 38, 38, 0.16);
    }

        .category-danger-button:hover {
            background: #b91c1c;
            transform: translateY(-1px);
            box-shadow: 0 13px 28px rgba(220, 38, 38, 0.22);
        }

    .category-secondary-button {
        border: 1px solid #cfe0d3;
        background: white;
        color: #166534;
    }

        .category-secondary-button:hover {
            background: #f2fbf5;
            border-color: #b9d8c0;
            color: #14532d;
            transform: translateY(-1px);
        }

    .category-glow {
        position: absolute;
        border-radius: 50%;
        opacity: 0.48;
        filter: blur(5px);
    }

    .category-glow-one {
        width: 260px;
        height: 260px;
        top: -110px;
        right: 8%;
        background: rgba(74, 222, 128, 0.17);
    }

    .category-glow-two {
        width: 290px;
        height: 290px;
        bottom: -145px;
        left: 7%;
        background: rgba(16, 185, 129, 0.14);
    }

    @@media (max-width: 576px) {

        .category-page {
            padding: 35px 15px;
        }

        .category-card {
            padding: 30px 22px;
        }

        .category-actions {
            flex-direction: column;
        }

        .category-title {
            font-size: 1.7rem;
        }
    }

</style>