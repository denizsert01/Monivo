@{
    ViewData["Title"] = "Home";
}

<div class="monivo-home">
    <div class="monivo-glow glow-one"></div>
    <div class="monivo-glow glow-two"></div>

    <div class="hero-content">

        <div class="brand-badge">
            ✦ Personal Finance
        </div>

        <h1 class="hero-title">
            Take control of
            <br />
            your <span>money.</span>
        </h1>

        <p class="hero-description">
            Track your income, manage your expenses and build better financial habits
            <br />
            with Monivo.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <p class="welcome-text">
                Welcome back 👋
            </p>

            <div class="hero-actions">
                <a asp-controller="Transaction"
                   asp-action="Index"
                   class="btn-monivo-primary">
                    View Transactions
                </a>

                <a asp-controller="Category"
                   asp-action="Index"
                   class="btn-monivo-secondary">
                    Manage Categories
                </a>
            </div>
        }
        else
        {
            <div class="hero-actions">
                <a asp-controller="Account"
                   asp-action="Register"
                   class="btn-monivo-primary">
                    Get Started
                </a>

                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn-monivo-secondary">
                    Login
                </a>
            </div>
        }

        <div class="feature-row">

            <div class="feature-item">
                <span class="feature-icon">↗</span>

                <div>
                    <strong>Track Income</strong>
                    <small>See where your money comes from</small>
                </div>
            </div>

            <div class="feature-item">
                <span class="feature-icon">↘</span>

                <div>
                    <strong>Manage Expenses</strong>
                    <small>Understand where your money goes</small>
                </div>
            </div>

            <div class="feature-item">
                <span class="feature-icon">◎</span>

                <div>
                    <strong>Stay in Control</strong>
                    <small>Build healthier financial habits</small>
                </div>
            </div>

        </div>
    </div>
</div>

<footer class="monivo-footer">
    <div class="footer-left">
        <span>© 2026 Monivo</span>
        <span class="footer-divider"></span>
        <span>All rights reserved.</span>
    </div>

    <div class="footer-center">
        <span>🌿 Built with</span>
        <span class="footer-heart">♥</span>
        <span>for better financial habits</span>
    </div>

    <div class="footer-right">
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Use</a>
        <a href="#">Contact</a>
    </div>
</footer>

<style>

    .monivo-home {
        position: relative;
        min-height: 82vh;
        display: flex;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        border-radius: 28px;
        padding: 70px 30px 60px;
        background: radial-gradient( circle at 15% 20%, rgba(34, 197, 94, 0.20), transparent 35% ), radial-gradient( circle at 85% 80%, rgba(16, 185, 129, 0.18), transparent 35% ), linear-gradient( 135deg, #f7fff9 0%, #edf9f1 45%, #e7f7ee 100% );
    }

    .hero-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 900px;
        text-align: center;
    }

    .brand-badge {
        display: inline-block;
        padding: 8px 16px;
        margin-bottom: 28px;
        background: rgba(255, 255, 255, 0.70);
        border: 1px solid rgba(22, 101, 52, 0.12);
        border-radius: 999px;
        color: #15803d;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.4px;
        backdrop-filter: blur(10px);
    }

    .hero-title {
        margin-bottom: 24px;
        color: #122016;
        font-size: clamp(3rem, 7vw, 5.6rem);
        font-weight: 750;
        line-height: 1;
        letter-spacing: -4px;
    }

        .hero-title span {
            color: #16a34a;
        }

    .hero-description {
        max-width: 680px;
        margin: 0 auto 30px;
        color: #5e7064;
        font-size: 1.12rem;
        line-height: 1.7;
    }

    .welcome-text {
        margin-bottom: 18px;
        color: #166534;
        font-weight: 600;
    }

    .hero-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-monivo-primary,
    .btn-monivo-secondary {
        display: inline-block;
        padding: 13px 26px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .btn-monivo-primary {
        background: #15803d;
        color: white;
        border: 1px solid #15803d;
        box-shadow: 0 10px 24px rgba(21, 128, 61, 0.18);
    }

        .btn-monivo-primary:hover {
            background: #166534;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(21, 128, 61, 0.24);
        }

    .btn-monivo-secondary {
        background: rgba(255, 255, 255, 0.70);
        color: #166534;
        border: 1px solid rgba(22, 101, 52, 0.15);
        backdrop-filter: blur(10px);
    }

        .btn-monivo-secondary:hover {
            background: white;
            color: #14532d;
            transform: translateY(-2px);
        }

    .feature-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-top: 70px;
    }

    .feature-item {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 95px;
        padding: 20px;
        text-align: left;
        background: rgba(255, 255, 255, 0.58);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 17px;
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 35px rgba(21, 80, 45, 0.06);
    }

    .feature-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 42px;
        height: 42px;
        background: #dcfce7;
        border-radius: 11px;
        color: #15803d;
        font-size: 1.25rem;
        font-weight: bold;
    }

    .feature-item strong {
        display: block;
        color: #1c2c21;
        font-size: 0.95rem;
    }

    .feature-item small {
        display: block;
        margin-top: 4px;
        color: #718078;
        font-size: 0.77rem;
        line-height: 1.4;
    }

    .monivo-glow {
        position: absolute;
        border-radius: 50%;
        opacity: 0.5;
        filter: blur(5px);
    }

    .glow-one {
        width: 270px;
        height: 270px;
        top: -110px;
        right: 7%;
        background: rgba(74, 222, 128, 0.18);
    }

    .glow-two {
        width: 320px;
        height: 320px;
        bottom: -150px;
        left: 5%;
        background: rgba(16, 185, 129, 0.15);
    }

    .monivo-footer {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 25px;
        padding: 28px 10px 10px;
        color: #66746b;
        font-size: 0.9rem;
    }

    .footer-left,
    .footer-center,
    .footer-right {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .footer-center {
        justify-content: center;
    }

    .footer-right {
        justify-content: flex-end;
    }

        .footer-right a {
            color: #66746b;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .footer-right a:hover {
                color: #15803d;
            }

    .footer-divider {
        width: 1px;
        height: 18px;
        background: #d7dfda;
    }

    .footer-heart {
        color: #16a34a;
        font-size: 1rem;
    }

    @@media (max-width: 900px) {

        .monivo-home {
            min-height: auto;
            padding: 60px 20px;
        }

        .hero-title {
            letter-spacing: -2px;
        }

        .feature-row {
            grid-template-columns: 1fr;
            max-width: 520px;
            margin: 50px auto 0;
        }

        .monivo-footer {
            grid-template-columns: 1fr;
            text-align: center;
        }

        .footer-left,
        .footer-center,
        .footer-right {
            justify-content: center;
            flex-wrap: wrap;
        }
    }

</style>