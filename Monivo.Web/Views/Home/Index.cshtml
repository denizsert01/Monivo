@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1><b>Monivo</b></h1>
  
    <p style="color: forestgreen; font-family: 'Times New Roman', Times, sans-serif;">
        <b>personal finance application</b>
    </p>


    @if (User.Identity?.IsAuthenticated == true)
    {
        <p>Welcome back!</p>

        <a asp-controller="Category"
           asp-action="Index"
           class="btn btn-primary">
            Go to Categories
        </a>
    }
    else
    {
        <a asp-controller="Account"
           asp-action="Login"
           class="btn btn-primary">
            Login
        </a>
    }
</div>